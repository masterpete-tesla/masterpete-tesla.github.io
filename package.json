{
  "name": "tesla-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Tesla vehicle control via Fleet API",
  "type": "module",
  "bin": {
    "tesla-mcp-server": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "tesla",
    "mcp",
    "fleet-api",
    "model-context-protocol"
  ],
  "author": "Tyler Gibbs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tylergibbs1/tesla-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/tylergibbs1/tesla-mcp-server/issues"
  },
  "homepage": "https://github.com/tylergibbs1/tesla-mcp-server#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/server": "^2.0.0-alpha.2",
    "commander": "^14.0.3",
    "toml": "^4.1.1",
    "undici": "^8.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
